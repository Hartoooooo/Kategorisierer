# Finnhub API Konfiguration
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_SECRET=dein_finnhub_api_key_hier

# Optional: Weitere API-Keys – NUR aktiv wenn Zeile ausgeklammert (#) entfernt wird
# Variablen müssen exakt heißen: FINNHUB_SECRET_2, FINNHUB_SECRET_3
# FINNHUB_SECRET_2=zweiter_finnhub_api_key_hier
# FINNHUB_SECRET_3=dritter_finnhub_api_key_hier

# Optional: Concurrency Limit pro Key (Standard: 17)
# Mit N Keys: Limit = 17 × N (z.B. 3 Keys = 51 parallele Requests)
# FINNHUB_CONCURRENCY_LIMIT=17

# Supabase Konfiguration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Upload Limits
APP_MAX_UPLOAD_MB=10
